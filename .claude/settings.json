{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "permissions": {
    "allow": [
      "Bash(source ~/.nvm/nvm.sh)",
      "Bash(nvm use *)",
      "Bash(nvm use)",
      "Bash(node -v)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run start)",
      "Bash(npm start)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm audit *)",
      "Bash(npm audit)",
      "Bash(npm ls *)",
      "Bash(npx next start *)",
      "Bash(npx tsc --noEmit)",
      "Bash(curl * http://localhost:*)",
      "Bash(curl -s localhost:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(cat .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env*)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(rm *)"
    ]
  }
}
