# Server-only. Never prefix these with NEXT_PUBLIC_ — that would ship them to the browser.

# n8n webhook that performs the try-on generation (required)
N8N_WEBHOOK_URL=

# Optional shared secret sent as the X-Webhook-Secret header.
# Configure the n8n Webhook node with Header Auth using the same name/value so only this app can call it.
N8N_WEBHOOK_SECRET=

# Supabase Auth (required). Used only on the server, so no NEXT_PUBLIC_ prefix is needed.
# Project Settings → API: the project URL and the publishable key (sb_publishable_…)
SUPABASE_URL=https://cltnyzcbuvboqhvcftxh.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Stripe subscription ($9.99/month). Both are public Stripe URLs, but they are read on the server only.
# Payment Link for the subscription price (the paywall appends client_reference_id and prefilled_email)
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_cNi7sM6YkdiHglm5CHg7e00
# Customer portal login link, where subscribers manage or cancel
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/test_cNi7sM6YkdiHglm5CHg7e00
