# Server-only. Never prefix these with NEXT_PUBLIC_ — that would ship them to the browser.

# n8n webhook that performs the try-on generation (required)
N8N_WEBHOOK_URL=

# Optional shared secret sent as the X-Webhook-Secret header.
# Configure the n8n Webhook node with Header Auth using the same name/value so only this app can call it.
N8N_WEBHOOK_SECRET=
